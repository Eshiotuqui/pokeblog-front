# Endereço da API (só a origem, sem barra nem caminho no final)
API_URL=http://localhost:4000

# Segredo que o site e a API compartilham (MESMO valor nos dois, 32+ caracteres): assina o IP real do visitante
# que o site repassa à API, para os limites de tentativa valerem por pessoa. Sem ele a API só enxerga o servidor do site.
PROXY_SECRET=

# Chave PÚBLICA do login (a JWT_PUBLIC_KEY da API, em base64). Com ela o site confere a assinatura RSA do cookie
# e barra /admin, /perfil e /favoritos antes de entregar a página. Pública: não revela nada, não permite forjar login.
JWT_PUBLIC_KEY=

# Endereço público do SITE, com o /blog (o blog mora em pokegoguide.com/blog). Usado no canonical, no sitemap,
# no robots e nos dados estruturados. Se vier sem o /blog, ele é acrescentado.
NEXT_PUBLIC_SITE_URL=http://localhost:3000/blog
# O app principal, para o atalho da barra lateral e a marca nos dados estruturados
NEXT_PUBLIC_MAIN_SITE=https://pokegoguide.com

# Google Analytics 4 (ID de medição, começa com G-). Vazio = desligado.
NEXT_PUBLIC_GA_ID=
# Search Console: código do método "tag HTML" (só o valor de content). Se verificar pelo DNS, deixe vazio.
NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster (opcional)
NEXT_PUBLIC_BING_VERIFICATION=
