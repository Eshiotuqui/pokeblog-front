# Endereço da API (só a origem, sem barra nem caminho no final)
API_URL=http://localhost:4000

# Endereço público do SITE. Usado no canonical, no sitemap, no robots e nos dados estruturados.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# O app principal, para o atalho da barra lateral e a marca nos dados estruturados
NEXT_PUBLIC_MAIN_SITE=https://pokegoguide.com

# Google Analytics 4 (ID de medição, começa com G-). Vazio = desligado.
NEXT_PUBLIC_GA_ID=
# Search Console: código do método "tag HTML" (só o valor de content). Se verificar pelo DNS, deixe vazio.
NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster (opcional)
NEXT_PUBLIC_BING_VERIFICATION=
